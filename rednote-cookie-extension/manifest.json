{
  "manifest_version": 3,
  "name": "RedNote Cookie Copier",
  "version": "2.0.0",
  "description": "คัดลอก Cookie RedNote (小红书) ในคลิกเดียว สำหรับ Douyin & Bilibili Hub",
  "permissions": [
    "cookies",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.xiaohongshu.com/*",
    "*://*.rednote.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RedNote Cookie Copier",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
